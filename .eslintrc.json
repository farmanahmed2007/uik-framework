{
  "root": true,
  "env": {
    "browser": true,
    "jquery": true,
    "es6": true
  },
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "globals": {
    "UIKNavigation": "readonly",
    "UIKTables": "readonly"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "none"
      }
    ],
    "no-undef": "error",
    "eqeqeq": [
      "warn",
      "smart"
    ],
    "no-redeclare": "error",
    "no-shadow": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-alert": "error",
    "no-var": "off",
    "curly": [
      "warn",
      "all"
    ],
    "semi": [
      "warn",
      "always"
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/lib/js/uik.js"
      ],
      "env": {
        "commonjs": true,
        "browser": true,
        "jquery": true
      }
    },
    {
      "files": [
        "test/**/*.js"
      ],
      "env": {
        "qunit": true,
        "node": true
      },
      "globals": {
        "UIKTest": "readonly",
        "sinon": "readonly"
      }
    },
    {
      "files": [
        "karma.conf.js",
        "webpack.config.js",
        "test/chrome-bin.js"
      ],
      "env": {
        "node": true,
        "browser": false
      },
      "parserOptions": {
        "ecmaVersion": 2018
      }
    }
  ]
}
